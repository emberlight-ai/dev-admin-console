# Copy this file to /home/ubuntu/dev-admin-console/.env.production
# and fill in real values before running `npm run build`.
#
# Required (client + server)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional (server admin access; if omitted, anon key is used)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Admin console login (used by src/actions/auth.ts)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me"

# AI: Vertex only. Keep the service-account file outside the repository.
# See docs/ai-configuration.md for the Supabase credential setup.
GOOGLE_CLOUD_PROJECT_ID="the-method-392512"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
AI_UTILITY_MODEL="gemini-3.1-flash-lite"
AI_REPLY_MODEL="gemini-3.1-flash-lite"


